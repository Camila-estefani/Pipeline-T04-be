##############################################################################
# Visons Backend - Environment Configuration
# Variables de entorno para Docker Compose
##############################################################################

# ============================================================================
# SQL SERVER CONFIGURATION
# ============================================================================
# Contraseña para usuario administrador (sa)
MSSQL_SA_PASSWORD=Admin12345!

# URL de conexión JDBC para SQL Server
# Formato: jdbc:sqlserver://[HOST]:[PORT];databaseName=[DB_NAME]
DB_URL=jdbc:sqlserver://mssql-server:1433;databaseName=Visons;encrypt=true;trustServerCertificate=true

# Usuario de base de datos
DB_USER=sa

# Contraseña de base de datos
DB_PASSWORD=Admin12345!

# ============================================================================
# SPRING BOOT CONFIGURATION
# ============================================================================
# Puerto en el que escucha la aplicación
PORT=9090

# URL base de la aplicación
SERVER_URL=http://localhost:9090

# Perfil activo (docker, dev, prod)
SPRING_PROFILES_ACTIVE=docker

##############################################################################
# NOTAS DE SEGURIDAD
# ============================================================================
# ⚠️  IMPORTANTE: En producción cambiar:
#   - MSSQL_SA_PASSWORD: Usar contraseña fuerte de 8+ caracteres
#   - DB_PASSWORD: Usar contraseña fuerte
#   - encrypt=true, trustServerCertificate=true: Usar certificados válidos
##############################################################################
